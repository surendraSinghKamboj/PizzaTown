# Copy this file to keystore.properties (same folder, root of the repo)
# and fill in your real values. keystore.properties itself is
# .gitignore'd — never commit your real keystore path/passwords.
#
# See README § Release Build for how to generate the .jks keystore file.

storeFile=/absolute/path/to/pizzatown-release.jks
storePassword=changeme
keyAlias=pizzatown
keyPassword=changeme
